MODULE main
VAR
  state : {LOGIN, RETRIEVE, LLM_RESPONSE, COMPLETE};
  auth_ok : boolean;
  acl_ok : boolean;
  fuzzy : {ALLOW, STEP_UP, DENY};
ASSIGN
  init(state) := LOGIN;
  init(auth_ok) := {TRUE, FALSE};
  next(auth_ok) := auth_ok;
  init(acl_ok) := {TRUE, FALSE};
  next(acl_ok) := acl_ok;
  init(fuzzy) := {ALLOW, STEP_UP, DENY};
  next(fuzzy) := fuzzy;
  next(state) := case
    state = LOGIN : RETRIEVE;
    state = RETRIEVE : LLM_RESPONSE;
    state = LLM_RESPONSE : COMPLETE;
    state = COMPLETE : COMPLETE;
    TRUE : state;
  esac;

-- Negative-control properties: each must be falsifiable because the gates are absent.
CTLSPEC AG (!auth_ok -> state != RETRIEVE)
CTLSPEC AG (!acl_ok -> state != RETRIEVE)
CTLSPEC AG (state = RETRIEVE -> (auth_ok & acl_ok))
CTLSPEC AG ((fuzzy = ALLOW & !acl_ok) -> state != RETRIEVE)
