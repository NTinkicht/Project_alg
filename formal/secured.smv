MODULE main
VAR
  state : {LOGIN, AUTHENTICATED, RISK_CHECK, ACL_CHECK, RETRIEVE, LLM_RESPONSE, DENIED, COMPLETE};
  auth_ok : boolean;
  acl_ok : boolean;
  fuzzy : {ALLOW, STEP_UP, DENY};
ASSIGN
  init(state) := LOGIN;
  init(auth_ok) := {TRUE, FALSE};
  next(auth_ok) := auth_ok;
  init(acl_ok) := {TRUE, FALSE};
  next(acl_ok) := acl_ok;
  init(fuzzy) := {ALLOW, STEP_UP, DENY};
  next(fuzzy) := fuzzy;
  next(state) := case
    state = LOGIN & auth_ok : AUTHENTICATED;
    state = LOGIN & !auth_ok : DENIED;
    state = AUTHENTICATED : RISK_CHECK;
    state = RISK_CHECK & fuzzy = DENY : DENIED;
    state = RISK_CHECK & fuzzy != DENY : ACL_CHECK;
    state = ACL_CHECK & acl_ok : RETRIEVE;
    state = ACL_CHECK & !acl_ok : DENIED;
    state = RETRIEVE : LLM_RESPONSE;
    state = LLM_RESPONSE : COMPLETE;
    state = DENIED : DENIED;
    state = COMPLETE : COMPLETE;
    TRUE : state;
  esac;

-- P1: Authentication failure cannot reach authenticated processing, retrieval, or LLM states.
CTLSPEC AG (!auth_ok -> (state != AUTHENTICATED & state != RISK_CHECK & state != ACL_CHECK & state != RETRIEVE & state != LLM_RESPONSE & state != COMPLETE))
-- P2: ACL-denied requests never reach retrieval.
CTLSPEC AG (!acl_ok -> state != RETRIEVE)
-- P3: Retrieval implies both successful authentication and deterministic ACL authorization.
CTLSPEC AG (state = RETRIEVE -> (auth_ok & acl_ok))
-- P4: Fuzzy ALLOW cannot override an ACL denial.
CTLSPEC AG ((fuzzy = ALLOW & !acl_ok) -> state != RETRIEVE)
-- P5: A fuzzy DENY at the risk gate transitions immediately to the safe terminal state.
CTLSPEC AG ((state = RISK_CHECK & fuzzy = DENY) -> AX state = DENIED)
-- P6: A valid authenticated, authorized, non-denied request eventually completes.
CTLSPEC AG ((state = AUTHENTICATED & auth_ok & acl_ok & fuzzy != DENY) -> AF state = COMPLETE)
-- P7: Authentication failure at LOGIN transitions immediately to DENIED.
CTLSPEC AG ((state = LOGIN & !auth_ok) -> AX state = DENIED)
